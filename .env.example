# Copy to .env for local development only. Keep every credential out of source control.

# Shared PostgreSQL connection
DATABASE_URL=
DB_HOST=db
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Valkey private service
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_PASSWORD=
DRIFT_QUEUE_NAME=drift_eval_queue

# Qdrant private service
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=drift_baselines

# Dashboard server-side proxy; never prefix this secret with NEXT_PUBLIC_.
API_INTERNAL_URL=http://api:8000
DRIFTGUARD_DASHBOARD_API_KEY=
DRIFTGUARD_DASHBOARD_USERNAME=
DRIFTGUARD_DASHBOARD_PASSWORD=
DRIFTGUARD_ADMIN_TOKEN=
DRIFTGUARD_BOOTSTRAP_PROJECT_KEY=

# API admission control
MAX_REQUEST_BYTES=262144
INGEST_RATE_LIMIT_REQUESTS=1000
INGEST_RATE_LIMIT_WINDOW_SECONDS=1
RATE_LIMIT_FAIL_OPEN=true

# Pinned local embedding model and bounded worker execution
EMBEDDING_MODEL=models/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_TTL_SECONDS=3600
BASELINE_CACHE_TTL_SECONDS=86400
MAX_TEXT_CHARACTERS=2048
WORKER_CONCURRENCY=4
DB_POOL_MAX_SIZE=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=15
WORKER_JOB_HEALTH_TIMEOUT_SECONDS=60
WORKER_MAX_JOB_ATTEMPTS=3
DELIVERY_POLL_INTERVAL_SECONDS=1
DELIVERY_BATCH_SIZE=100
DELIVERY_LEASE_SECONDS=60
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RECEIPT_TTL_SECONDS=86400
QDRANT_CIRCUIT_FAILURE_THRESHOLD=3
QDRANT_CIRCUIT_RESET_SECONDS=30

# Automated, legal-hold-aware retention. PostgreSQL deletion commits a durable
# Qdrant deletion outbox before relational telemetry is removed.
RETENTION_ENABLED=true
RETENTION_INTERVAL_SECONDS=60
RETENTION_RAW_TEXT_DAYS=30
RETENTION_TELEMETRY_DAYS=90
RETENTION_OUTBOX_DAYS=7
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES=10

# Shared API/worker SSRF policy for generic webhooks (comma-separated bare domains)
WEBHOOK_ALLOWED_HOSTS=

# Optional SMTP transport for DIGEST rules whose target is a mailto: URI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_SECURITY=starttls
